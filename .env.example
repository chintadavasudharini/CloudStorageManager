# Flask Configuration
FLASK_SECRET_KEY=supersecret-dev-key-change-in-production
FLASK_ENV=development
PORT=5000

# AWS IAM Credentials (Leave blank to use AWS IAM Roles, ~/.aws/credentials, or Demo Mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Optional default bucket
DEFAULT_S3_BUCKET=

# Enable built-in Moto mock S3 demo mode when no real AWS credentials are provided
ENABLE_DEMO_MODE=true
